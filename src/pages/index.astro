---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import Icon from '../components/Icon.astro';
import InquiryBand from '../components/InquiryBand.astro';
import { services } from '../data/services';
import { galleryItems, selectedWork } from '../data/gallery';
import { decor, decorVideo } from '../data/decor';

// Hero: H1 (landscape, desktop) and H2 (portrait, recomposed for mobile).
const h1 = decor('h1-desktop') ?? decor('hero-petals');
const h2 = decor('h2-mobile') ?? h1;
const loop = decorVideo('v1-loop');

const desk = h1 && (await getImage({ src: h1.image, width: 1600, format: 'webp' }));
const deskSet = h1 && (await Promise.all([900, 1300, 1800].map((w) => getImage({ src: h1.image, width: w, format: 'webp' }))));
const mob = h2 && (await Promise.all([480, 720, 1000].map((w) => getImage({ src: h2.image, width: w, format: 'webp' }))));
const og = h1 && (await getImage({ src: h1.image, width: 1200, height: 630, fit: 'cover', format: 'jpg' }));
const srcset = (list?: { src: string; attributes: Record<string, unknown> }[]) =>
  list?.map((v) => `${v.src} ${v.attributes.width}w`).join(', ');

const work = selectedWork(5);
const storyPhoto = galleryItems.find((g) => g.id === 'img005') ?? galleryItems[galleryItems.length - 1];
---

<Base
  title="The Flower Studio TCI"
  description="Floral arrangements, wedding decoration, and corporate, house guest and luxury hotel flowers from The Flower Studio at Ports of Call, Grace Bay, Turks and Caicos."
  image={og?.src}
  business
>
  {desk && <link slot="head" rel="preload" as="image" type="image/webp" imagesrcset={srcset(deskSet)} imagesizes="(min-width: 861px) 46vw, 100vw" fetchpriority="high" />}

  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title">
        <span class="line"><span>Bringing flower elegance</span></span>
        <span class="line"><span>to your <em>island</em> experience</span></span>
      </h1>
      <p class="lede">
        Arrangements, wedding decoration and hospitality florals from our studio at Ports of Call, Grace Bay.
      </p>
      <div class="hero-actions">
        <a class="button" href="/gallery/">Explore the Gallery <Icon name="arrow-right" class="arrow" /></a>
        <a class="button button--ghost" href="/contact/">Request Flowers</a>
      </div>
    </div>

    <figure class="hero-media">
      <div class="frame frame--arch arch" data-hero-media>
        {
          desk ? (
            <picture>
              {mob && <source media="(max-width: 860px)" srcset={srcset(mob)} sizes="100vw" />}
              <img
                src={desk.src}
                srcset={srcset(deskSet)}
                sizes="(min-width: 861px) 46vw, 100vw"
                alt={h1!.alt}
                width={desk.attributes.width as number}
                height={desk.attributes.height as number}
                fetchpriority="high"
                decoding="async"
              />
            </picture>
          ) : (
            <div class="pending" role="img" aria-label="Hero image pending">
              <span>Hero image pending</span>
            </div>
          )
        }
        {
          loop.length > 0 && (
            <video class="hero-video" data-hero-video muted loop playsinline preload="none" aria-hidden="true" tabindex="-1">
              {loop.map((s) => (
                <source data-src={s.src} type={s.type} />
              ))}
            </video>
          )
        }
      </div>
      <figcaption>
        <span class="concept-tag">Concept image, generated for this design</span>
        {
          loop.length > 0 && (
            <button class="motion-toggle" type="button" data-motion-toggle aria-pressed="false" hidden>
              Pause motion
            </button>
          )
        }
      </figcaption>
    </figure>
  </section>

  <section class="section entries" aria-labelledby="entries-title">
    <div class="wrap">
      <h2 id="entries-title" data-reveal>For every occasion on the island</h2>
      <ul class="entry-list">
        {
          services.map((s, i) => (
            <li data-reveal style={`--reveal-delay: ${i * 70}`}>
              <a href={`/our-services/#${s.id}`}>
                <span class="entry-title">{s.title}</span>
                <span class="entry-summary">{s.summary}</span>
                <span class="entry-go">
                  Discover <Icon name="arrow-right" class="arrow" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section work" aria-labelledby="work-title">
    <div class="wrap">
      <div class="work-head" data-reveal>
        <h2 id="work-title">From the studio</h2>
        <p class="lede">Arrangements composed at Ports of Call, photographed in the studio.</p>
      </div>
      <ul class="strip">
        {
          work.map((p, i) => (
            <li data-reveal style={`--reveal-delay: ${i * 80}`}>
              <a href={`/gallery/?view=${p.id}`} class="strip-link">
                <Media image={p.image} alt={p.alt} ratio={i === 0 ? 4 / 5 : 3 / 4} arch zoom sizes="(min-width: 1024px) 24vw, (min-width: 640px) 45vw, 75vw" />
                <span class="caption">{p.caption}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <a class="link to-gallery" href="/gallery/">Explore the Gallery <Icon name="arrow-right" class="arrow" /></a>
    </div>
  </section>

  <section class="section story" aria-labelledby="story-title">
    <div class="wrap story-grid">
      <figure class="story-photo" data-reveal>
        <Media image={storyPhoto?.image} alt={storyPhoto?.alt ?? ''} ratio={4 / 5} arch native sizes="(min-width: 1024px) 30vw, 90vw" />
        <figcaption class="caption">From the studio’s portfolio</figcaption>
      </figure>
      <div class="story-copy" data-reveal style="--reveal-delay: 120">
        <h2 id="story-title">Our story</h2>
        <div class="prose">
          <p>
            In March 2023, The Flower Studio at Ports of Call blossomed into existence, with a vision of exceptional floral
            creations for the Turks and Caicos Islands, for the community who live here and the visitors they welcome.
          </p>
          <p>
            Founded by a young entrepreneur with a background in luxury services, the studio brings a passion for elegance
            and refined service to every order, shaped by years of island life and its particular tastes.
          </p>
        </div>
        <a class="link" href="/our-services/">Explore our services <Icon name="arrow-right" class="arrow" /></a>
      </div>
    </div>
  </section>

  <InquiryBand />
</Base>

<style>
  /* Hero ------------------------------------------------------------------ */
  .hero {
    display: grid;
    gap: 2rem;
    padding: clamp(1.5rem, 4vw, 2.5rem) 0 0;
  }

  .hero-copy {
    padding-inline: var(--gutter);
    display: grid;
    gap: 1.5rem;
    align-content: center;
    justify-items: start;
  }

  .hero h1 {
    font-size: clamp(2.6rem, 1.5rem + 3.6vw, 4.6rem);
    line-height: 1.04;
  }

  .hero h1 .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }

  .hero h1 .line > span {
    display: inline-block;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .hero-media {
    padding-inline: var(--gutter);
    display: grid;
    gap: 0.6rem;
  }

  .arch {
    aspect-ratio: 3 / 4;
  }

  .arch > picture,
  .arch > picture > img,
  .arch > video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 64% 50%;
  }

  .hero-video {
    opacity: 0;
    transition: opacity 1.6s var(--ease-out);
  }

  .hero-video.is-playing {
    opacity: 1;
  }

  .hero-media figcaption {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    min-height: 44px;
  }

  .motion-toggle {
    min-height: 44px;
    padding: 0 1rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--pill);
    background: transparent;
    font-size: 0.8125rem;
  }

  @media (min-width: 861px) {
    .hero {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(2rem, 4vw, 4.5rem);
      align-items: end;
      min-height: calc(100svh - 5rem);
      padding: 1rem 0 0;
    }

    .hero-copy {
      padding-inline: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter))) 0;
      padding-bottom: clamp(3rem, 8vh, 6rem);
    }

    .hero-media {
      padding-inline: 0 max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
    }

    .arch {
      aspect-ratio: auto;
      height: min(78svh, 58rem);
      min-height: 30rem;
    }
  }

  /* Focal moment: the arch opens upward while the headline rises. */
  @media (prefers-reduced-motion: no-preference) {
    .hero h1 .line > span {
      animation: rise 1.1s var(--ease-out) both;
    }
    .hero h1 .line + .line > span {
      animation-delay: 0.12s;
    }
    .hero .lede,
    .hero-actions {
      animation: fade 0.9s var(--ease-out) 0.45s both;
    }
    .arch {
      animation: unveil 1.6s var(--ease-arch) 0.05s both;
    }
    .arch > picture {
      animation: settle 2.6s var(--ease-out) 0.05s both;
    }
  }

  @keyframes rise {
    from {
      transform: translateY(105%);
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }
  @keyframes unveil {
    from {
      clip-path: inset(100% 0 0 0 round 999px 999px 0 0);
    }
    to {
      clip-path: inset(0 0 0 0 round 999px 999px 0 0);
    }
  }
  @keyframes settle {
    from {
      transform: scale(1.08);
    }
  }

  /* Service entry points -------------------------------------------------- */
  .entries {
    background: var(--sand);
    margin-top: clamp(3rem, 7vw, 6rem);
  }

  .entries h2 {
    font-size: var(--step-4);
    max-width: 16ch;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .entry-list {
    list-style: none;
    padding: 0;
    display: grid;
    border-top: 1px solid var(--rule);
  }

  .entry-list a {
    display: grid;
    gap: 0.5rem;
    padding: 1.4rem 0.25rem;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    height: 100%;
  }

  .entry-title {
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1.1;
    transition: color var(--dur-1) var(--ease-out);
  }

  .entry-summary {
    color: var(--ink-soft);
    font-size: 0.9688rem;
    max-width: 30rem;
  }

  .entry-go {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--lagoon);
    font-weight: 500;
    font-size: 0.9375rem;
  }

  .entry-list a:hover .entry-title,
  .entry-list a:focus-visible .entry-title {
    color: var(--lagoon);
    font-style: italic;
  }

  .entry-list a:hover :global(.arrow) {
    transform: translateX(0.25em);
  }

  @media (min-width: 1024px) {
    .entry-list {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      border-top: 0;
    }
    .entry-list li + li a {
      border-left: 1px solid var(--rule);
    }
    .entry-list a {
      grid-template-rows: auto 1fr auto;
      padding: 1.5rem 1.25rem 1.25rem;
      border-bottom: 0;
      min-height: 15rem;
    }
  }

  /* Portfolio preview ----------------------------------------------------- */
  .work-head {
    display: grid;
    gap: 1rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .work-head h2 {
    font-size: var(--step-5);
  }

  .strip {
    list-style: none;
    padding: 0;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 72%;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 0.75rem;
    align-items: end;
  }

  .strip li {
    scroll-snap-align: start;
  }

  .strip-link {
    display: grid;
    gap: 0.6rem;
    text-decoration: none;
  }

  .to-gallery {
    margin-top: 1.5rem;
  }

  @media (min-width: 640px) {
    .strip {
      grid-auto-columns: 42%;
    }
  }

  @media (min-width: 1024px) {
    .work-head {
      grid-template-columns: 1fr 1fr;
      align-items: end;
    }
    .strip {
      grid-auto-flow: row;
      grid-template-columns: 1.35fr repeat(4, minmax(0, 1fr));
      overflow: visible;
    }
  }

  /* Story ----------------------------------------------------------------- */
  .story {
    padding-top: 0;
  }

  .story-grid {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  .story-photo {
    display: grid;
    gap: 0.6rem;
    width: min(100%, 26rem);
  }

  .story-copy {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  .story-copy h2 {
    font-size: var(--step-5);
  }


  @media (min-width: 900px) {
    .story-grid {
      grid-template-columns: 5fr 6fr;
    }
    .story-photo {
      justify-self: center;
    }
  }
</style>

<script>
  // Desktop hero loop: plays only on wide screens, with motion welcome and data unconstrained.
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-motion-toggle]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const wide = matchMedia('(min-width: 861px)');
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;

  function start() {
    if (!video || reduce.matches || !wide.matches || saveData || video.dataset.loaded) return;
    video.dataset.loaded = '1';
    video.querySelectorAll('source').forEach((s) => (s.src = s.dataset.src!));
    video.load();
    video.addEventListener('playing', () => video.classList.add('is-playing'), { once: true });
    video.play().then(
      () => {
        if (toggle) toggle.hidden = false;
      },
      () => {
        /* Autoplay refused: the still image remains. */
      },
    );
  }

  // Start after the page has painted so the still stays the LCP element.
  if (document.readyState === 'complete') setTimeout(start, 400);
  else addEventListener('load', () => setTimeout(start, 400), { once: true });
  wide.addEventListener('change', start);

  toggle?.addEventListener('click', () => {
    if (!video) return;
    const pause = !video.paused;
    if (pause) video.pause();
    else void video.play();
    toggle.setAttribute('aria-pressed', String(pause));
    toggle.textContent = pause ? 'Play motion' : 'Pause motion';
  });

  reduce.addEventListener('change', (e) => {
    if (e.matches && video) {
      video.pause();
      video.classList.remove('is-playing');
      if (toggle) toggle.hidden = true;
    }
  });
</script>
