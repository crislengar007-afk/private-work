---
import Icon from '../components/Icon.astro';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import InquiryBand from '../components/InquiryBand.astro';
import { site } from '../data/site';
import { services } from '../data/services';
import { selectedWork, collectionLabel } from '../data/gallery';
import { decor, heroVideo } from '../data/decor';

const hero = decor('hero-petals');
const atelier = decor('atelier-table');
const video = heroVideo();
const poster = hero ? await getImage({ src: hero.image, width: 1920, format: 'webp' }) : undefined;
const og = hero ? await getImage({ src: hero.image, width: 1200, height: 630, fit: 'cover', format: 'jpg' }) : undefined;

const work = selectedWork(4);
const [a, b, c, d] = work;
const caption = (item?: (typeof work)[number]) => item?.caption ?? collectionLabel(item?.collection);
---

<Base
  title={site.name}
  description="The Flower Studio at Ports of Call creates floral design for events and personal celebrations across the Turks and Caicos Islands."
  image={og?.src}
>
  {poster && <link slot="head" rel="preload" as="image" href={poster.src} type="image/webp" fetchpriority="high" />}

  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title"><span class="line"><span>Flowers,</span></span> <span class="line"><em>composed.</em></span></h1>
      <p class="lede">
        Floral design for events and personal celebrations across the Turks and Caicos Islands.
      </p>
      <div class="hero-actions">
        <a class="button" href="/gallery/">View the gallery <Icon name="arrow-right" class="arrow" /></a>
        <a class="link" href="/services/">Services</a>
      </div>
    </div>

    <div class="hero-media frame" data-hero-media>
      {
        poster ? (
          <>
            <img
              class="hero-still"
              src={poster.src}
              alt={hero!.alt}
              width={poster.attributes.width}
              height={poster.attributes.height}
              fetchpriority="high"
              decoding="async"
            />
            {video && (
              <video
                class="hero-video"
                data-hero-video
                data-src={video}
                muted
                loop
                playsinline
                preload="none"
                poster={poster.src}
                aria-hidden="true"
                tabindex="-1"
              />
            )}
          </>
        ) : (
          <div class="pending" role="img" aria-label="Hero image pending download">
            <span>Hero image pending download</span>
          </div>
        )
      }
      {
        video && (
          <button class="motion-toggle" type="button" data-motion-toggle aria-pressed="false" hidden>
            Pause motion
          </button>
        )
      }
    </div>
  </section>

  <section class="section selected" aria-labelledby="selected-title">
    <div class="wrap grid-12">
      <div class="col-left">
        <div class="selected-intro" data-reveal>
          <h2 id="selected-title">Selected work</h2>
          <p class="lede">A few recent arrangements from the studio. The full gallery holds many more.</p>
        </div>
        {
          a && (
            <a class="work work--a" href={`/gallery/?view=${a.id}`} data-reveal>
              <Media image={a.image} alt={a.alt} ratio={3 / 2} sizes="(min-width: 1024px) 55vw, 100vw" zoom pendingLabel={a.caption} />
              {caption(a) && !a.placeholder && <span class="caption">{caption(a)}</span>}
            </a>
          )
        }
        {
          c && (
            <a class="work work--c" href={`/gallery/?view=${c.id}`} data-reveal>
              <Media image={c.image} alt={c.alt} ratio={4 / 5} sizes="(min-width: 1024px) 26vw, 70vw" zoom pendingLabel={c.caption} />
              {caption(c) && !c.placeholder && <span class="caption">{caption(c)}</span>}
            </a>
          )
        }
      </div>
      <div class="col-right">
        {
          b && (
            <a class="work work--b" href={`/gallery/?view=${b.id}`} data-reveal style="--reveal-delay: 120">
              <Media image={b.image} alt={b.alt} ratio={4 / 5} sizes="(min-width: 1024px) 34vw, 100vw" zoom pendingLabel={b.caption} />
              {caption(b) && !b.placeholder && <span class="caption">{caption(b)}</span>}
            </a>
          )
        }
        {
          d && (
            <a class="work work--d" href={`/gallery/?view=${d.id}`} data-reveal>
              <Media image={d.image} alt={d.alt} ratio={1} sizes="(min-width: 1024px) 26vw, 80vw" zoom pendingLabel={d.caption} />
              {caption(d) && !d.placeholder && <span class="caption">{caption(d)}</span>}
            </a>
          )
        }
        <a class="link to-gallery" href="/gallery/">View the gallery <Icon name="arrow-right" class="arrow" /></a>
      </div>
    </div>
  </section>

  <section class="section studio" aria-labelledby="studio-title">
    <div class="wrap grid-12">
      <h2 id="studio-title" class="visually-hidden">About the studio</h2>
      <p class="statement display" data-reveal>
        Opened at Ports of Call in March&nbsp;2023, The Flower Studio brings fresh, exquisite blooms to the islands'
        community and to the visitors <em>it welcomes.</em>
      </p>
      <figure class="studio-image" data-reveal>
        <Media
          image={atelier?.image}
          alt={atelier?.alt ?? ''}
          ratio={3 / 4}
          sizes="(min-width: 1024px) 34vw, 100vw"
          pendingLabel="Studio image pending download"
        />
        {atelier && <figcaption class="caption">Atmospheric image, generated for this site.</figcaption>}
      </figure>
      <div class="studio-copy prose" data-reveal style="--reveal-delay: 120">
        <p>
          The studio was founded by a young entrepreneur with a background in luxury services, and grew from a passion
          for elegance and refined service.
        </p>
        <p>
          Whether the flowers are for an event or a personal celebration, the aim is the same. A luxurious experience,
          tailored to what you need, finished with exquisite floral design.
        </p>
        <a class="link" href="/services/">How the studio can help <Icon name="arrow-right" class="arrow" /></a>
      </div>
    </div>
  </section>

  <section class="section offer" aria-labelledby="offer-title">
    <div class="wrap grid-12">
      <div class="offer-head" data-reveal>
        <h2 id="offer-title">Services</h2>
      </div>
      <ul class="offer-list">
        {
          services.map((s, i) => (
            <li data-reveal style={`--reveal-delay: ${i * 90}`}>
              <a href={`/services/#${s.id}`}>
                <span class="offer-title">{s.title}</span>
                <span class="offer-summary">{s.summary}</span>
                <Icon name="arrow-right" class="offer-arrow" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <InquiryBand />
</Base>

<style>
  /* Hero ------------------------------------------------------------------ */
  .hero {
    display: grid;
    gap: 2.5rem;
    padding: clamp(2rem, 5vw, 3rem) 0 0;
  }

  .hero-copy {
    padding-inline: var(--gutter);
    display: grid;
    gap: 1.5rem;
    align-content: center;
    justify-items: start;
  }

  .hero h1 {
    font-size: var(--step-6);
    line-height: 1;
  }

  .hero h1 .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
  }

  .hero h1 .line > * {
    display: inline-block;
  }

  /* Focal moment: the photograph is unveiled from below while the headline
     rises into place. Pure CSS, so content never depends on script. */
  @media (prefers-reduced-motion: no-preference) {
    .hero h1 .line > * {
      animation: rise 1.1s var(--ease-out) both;
    }
    .hero h1 .line + .line > * {
      animation-delay: 0.12s;
    }
    .hero .lede,
    .hero-actions {
      animation: fade 0.9s var(--ease-out) 0.45s both;
    }
    .hero-media {
      animation: unveil 1.5s cubic-bezier(0.76, 0, 0.24, 1) 0.1s both;
    }
    .hero-media > img,
    .hero-media > video {
      animation: settle 2.4s var(--ease-out) 0.1s both;
    }
  }

  @keyframes rise {
    from {
      transform: translateY(105%);
    }
  }

  @keyframes fade {
    from {
      opacity: 0;
    }
  }

  @keyframes unveil {
    from {
      clip-path: inset(100% 0 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes settle {
    from {
      transform: scale(1.08);
    }
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    margin-top: 0.75rem;
  }

  .hero-media {
    position: relative;
    aspect-ratio: 4 / 5;
  }

  .hero-media > img,
  .hero-media > video {
    position: absolute;
    inset: 0;
    object-position: 68% 50%;
  }

  .hero-video {
    opacity: 0;
    transition: opacity 1.4s var(--ease-out);
  }

  .hero-video.is-playing {
    opacity: 1;
  }

  .motion-toggle {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    min-height: 44px;
    padding: 0 1rem;
    border: 1px solid rgb(243 241 234 / 0.5);
    background: rgb(16 22 18 / 0.45);
    color: #f3f1ea;
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
  }

  .motion-toggle:hover {
    background: rgb(16 22 18 / 0.65);
  }

  @media (min-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(2rem, 4vw, 4rem);
      min-height: calc(100svh - 4.5rem);
      padding: 0;
    }

    .hero-copy {
      padding-inline: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter))) 0;
      padding-block: 3rem 5rem;
    }

    .hero-media {
      aspect-ratio: auto;
      min-height: 32rem;
    }
  }

  /* Selected work ------------------------------------------------------------ */
  .col-left,
  .col-right {
    grid-column: 1 / -1;
    display: grid;
    gap: clamp(3rem, 7vw, 6rem);
    align-content: start;
  }

  .selected-intro {
    display: grid;
    gap: 1.25rem;
  }

  .work {
    display: grid;
    gap: 0.85rem;
    text-decoration: none;
  }

  .work:hover .caption {
    color: var(--ink);
  }

  .work--c {
    width: 72%;
    justify-self: end;
  }

  .work--d {
    width: 82%;
  }

  .to-gallery {
    justify-self: start;
  }

  .col-right {
    margin-top: clamp(3rem, 7vw, 6rem);
  }

  @media (min-width: 1024px) {
    .col-left {
      grid-column: 1 / span 7;
    }

    .col-right {
      grid-column: 9 / span 4;
      margin-top: clamp(10rem, 18vw, 16rem);
    }

    .work--c {
      width: 56%;
    }

    .work--d {
      width: 78%;
      justify-self: end;
    }
  }

  /* Studio ------------------------------------------------------------------ */
  .studio {
    padding-top: 0;
  }

  .statement {
    grid-column: 1 / -1;
    font-size: var(--step-4);
    line-height: 1.16;
    letter-spacing: -0.015em;
    max-width: 22ch;
    margin-bottom: clamp(3rem, 7vw, 6rem);
  }

  .studio-image {
    grid-column: 1 / -1;
    display: grid;
    gap: 0.75rem;
  }

  .studio-copy {
    grid-column: 1 / -1;
    margin-top: 2.5rem;
    align-self: end;
  }

  @media (min-width: 768px) {
    .statement {
      grid-column: 2 / span 10;
    }
    .studio-image {
      grid-column: 1 / span 6;
    }
    .studio-copy {
      grid-column: 8 / span 5;
      margin-top: 0;
      padding-bottom: 2rem;
    }
  }

  @media (min-width: 1024px) {
    .studio-image {
      grid-column: 2 / span 4;
    }
    .studio-copy {
      grid-column: 7 / span 5;
    }
  }

  /* Services index ------------------------------------------------------------ */
  .offer {
    padding-top: 0;
  }

  .offer-head {
    grid-column: 1 / -1;
    display: grid;
    gap: 1rem;
    align-content: start;
    margin-bottom: 2.5rem;
  }

  .offer-list {
    grid-column: 1 / -1;
    list-style: none;
    padding: 0;
    border-bottom: 1px solid var(--rule);
  }

  .offer-list a {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.5rem 1.5rem;
    padding-block: clamp(1.5rem, 3vw, 2.25rem);
    border-top: 1px solid var(--rule);
    text-decoration: none;
  }

  .offer-title {
    font-family: var(--font-display);
    font-size: var(--step-4);
    line-height: 1.08;
    letter-spacing: -0.02em;
    transition: color var(--dur-1) var(--ease-out);
  }

  .offer-summary {
    grid-column: 1;
    color: var(--ink-soft);
    max-width: 36rem;
  }

  .offer-list :global(.offer-arrow) {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    font-size: var(--step-2);
    transition: transform var(--dur-2) var(--ease-out);
  }

  .offer-list a:hover .offer-title,
  .offer-list a:focus-visible .offer-title {
    color: var(--rose);
    font-style: italic;
  }

  .offer-list a:hover :global(.offer-arrow) {
    transform: translateX(0.4rem);
  }

  @media (min-width: 1024px) {
    .offer-head {
      grid-column: 1 / span 4;
      position: sticky;
      top: 7rem;
      margin-bottom: 0;
    }
    .offer-list {
      grid-column: 5 / span 8;
    }
    .offer-list a {
      grid-template-columns: 5fr 4fr auto;
      align-items: baseline;
    }
    .offer-summary {
      grid-column: 2;
    }
    .offer-list :global(.offer-arrow) {
      grid-column: 3;
      grid-row: 1;
    }
  }
</style>

<script>
  // Hero loop: plays only when motion is welcome and data is not constrained.
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-motion-toggle]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;

  if (video && !reduce.matches && !saveData) {
    video.src = video.dataset.src!;
    video.addEventListener('playing', () => video.classList.add('is-playing'), { once: true });
    video.play().then(
      () => {
        if (toggle) toggle.hidden = false;
      },
      () => {
        /* Autoplay refused: the still image remains. */
      },
    );

    toggle?.addEventListener('click', () => {
      const pause = !video.paused;
      if (pause) video.pause();
      else video.play();
      toggle.setAttribute('aria-pressed', String(pause));
      toggle.textContent = pause ? 'Play motion' : 'Pause motion';
    });

    reduce.addEventListener('change', (e) => {
      if (e.matches) {
        video.pause();
        video.classList.remove('is-playing');
      }
    });
  }
</script>
