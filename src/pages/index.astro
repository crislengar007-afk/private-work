---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import MotionHero from '../components/MotionHero.astro';
import Favourites from '../components/Favourites.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Media from '../components/Media.astro';
import Icon from '../components/Icon.astro';
import InquiryBand from '../components/InquiryBand.astro';
import { services } from '../data/services';
import { galleryItems, selectedWork } from '../data/gallery';
import { decor, decorVideo } from '../data/decor';

// Full-screen hero: H1 with its loop V1 on wide screens; on phones, H2
// recomposed as a tall frame with its own loop V2.
const h1 = decor('h1-desktop')!;
const h2 = decor('h2-tall') ?? decor('h2-mobile');
const og = await getImage({ src: h1.image, width: 1200, height: 630, fit: 'cover', format: 'jpg' });

const favourites = selectedWork(10);
const storyPhoto = galleryItems.find((g) => g.id === 'img005') ?? galleryItems[galleryItems.length - 1];
---

<Base
  title="The Flower Studio TCI"
  description="Floral arrangements, wedding decoration, and corporate, house guest and luxury hotel flowers from The Flower Studio at Ports of Call, Grace Bay, Turks and Caicos."
  image={og.src}
  business
  overlay
>
  <MotionHero
    wide={h1.image}
    narrow={h2?.image}
    alt={h1.alt}
    wideVideo={decorVideo('v1-loop')}
    narrowVideo={decorVideo('m-home-tall')}
    labelledby="hero-title"
    next="#favourites"
    narrowAlign="top"
    scroll
  >
    <h1 id="hero-title">
      <span class="line"><span>Bringing flower elegance</span></span>
      <span class="line"><span>to your <em>island</em> experience</span></span>
    </h1>
    <p class="lede">
      Arrangements, wedding decoration and hospitality florals from our studio at Ports of Call, Grace Bay.
    </p>
    <div class="hero-actions" data-dock-hide>
      <a class="button" href="/gallery/">Explore the Gallery <Icon name="arrow-right" class="arrow" /></a>
      <a class="button button--on-media" href="/contact/">Request Flowers</a>
    </div>
    <p slot="after">Flowers for the island since March 2023, from our studio at <em>Ports of Call</em>.</p>
  </MotionHero>

  <Favourites
    id="favourites"
    heading="Some of our favourites"
    items={favourites}
    note="Arrangements composed at Ports of Call, photographed in the studio. Where a photograph moves, the motion was added digitally and is labelled."
  />

  <section class="section occasions" aria-labelledby="occasions-title">
    <div class="wrap">
      <div class="occasions-head" data-reveal>
        <h2 id="occasions-title">For every occasion on the island</h2>
        <p class="caption">
          Hover or focus a service to open it. These films are concepts generated for this design.
        </p>
      </div>
      <ul class="reel" data-reel>
        {
          services.map((s, i) => (
            <li class:list={{ 'is-open': i === 0 }}>
              <ServiceCard service={s} index={i} sizes="(min-width: 1024px) 50vw, 80vw" class="reel-card" motion="open" />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section story" aria-labelledby="story-title">
    <div class="wrap story-grid">
      <figure class="story-photo" data-reveal>
        <Media image={storyPhoto?.image} alt={storyPhoto?.alt ?? ''} ratio={4 / 5} native sizes="(min-width: 1024px) 30vw, 90vw" />
        <figcaption class="caption">From the studio’s portfolio</figcaption>
      </figure>
      <div class="story-copy" data-reveal style="--reveal-delay: 120">
        <h2 id="story-title">Our story</h2>
        <div class="prose">
          <p>
            In March 2023, The Flower Studio at Ports of Call blossomed into existence, with a vision of exceptional floral
            creations for the Turks and Caicos Islands, for the community who live here and the visitors they welcome.
          </p>
          <p>
            Founded by a young entrepreneur with a background in luxury services, the studio brings a passion for elegance
            and refined service to every order, shaped by years of island life and its particular tastes.
          </p>
        </div>
        <a class="link" href="/our-services/">Explore our services <Icon name="arrow-right" class="arrow" /></a>
      </div>
    </div>
  </section>

  <InquiryBand />
</Base>

<style>
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  /* Occasions: an expanding reel. The focused card opens to show its film. */
  .occasions {
    background: var(--sand);
  }

  .occasions-head {
    display: grid;
    gap: 1rem;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .occasions-head h2 {
    font-size: var(--step-5);
    max-width: 16ch;
  }

  .reel {
    list-style: none;
    padding: 0 var(--gutter) 0.75rem;
    margin-inline: calc(-1 * var(--gutter));
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(80vw, 24rem);
    gap: 0.75rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    overscroll-behavior-x: contain;
  }

  .reel > li {
    scroll-snap-align: start;
    display: grid;
  }

  .reel :global(.reel-card) {
    aspect-ratio: 3 / 4;
  }

  @media (min-width: 1024px) {
    .occasions-head {
      grid-template-columns: 1fr auto;
      align-items: end;
    }

    .reel {
      display: flex;
      height: min(74svh, 44rem);
      min-height: 30rem;
      margin-inline: 0;
      padding: 0;
      overflow: visible;
    }

    .reel > li {
      flex: 1 1 0;
      min-width: 0;
      transition: flex-grow 900ms var(--ease-out);
    }

    .reel > li.is-open {
      flex-grow: 3.4;
    }

    .reel :global(.reel-card) {
      aspect-ratio: auto;
    }

    /* Collapsed cards set their title upright along the edge; the open card
       reads normally and shows its summary. */
    .reel > li:not(.is-open) :global(.scard-body) {
      align-self: stretch;
      align-content: end;
    }

    .reel > li:not(.is-open) :global(.scard-title) {
      writing-mode: vertical-rl;
      rotate: 180deg;
      justify-self: start;
      font-size: var(--step-2);
      white-space: nowrap;
    }

    .reel :global(.scard-summary),
    .reel :global(.scard-go) {
      transition:
        opacity var(--dur-2) var(--ease-out) 200ms,
        transform var(--dur-2) var(--ease-out) 200ms;
    }

    .reel > li:not(.is-open) :global(.scard-summary),
    .reel > li:not(.is-open) :global(.scard-go) {
      display: none;
    }

    .reel > li.is-open :global(.scard-summary) {
      min-width: 20rem;
    }
  }

  @media (min-width: 1024px) and (prefers-reduced-motion: reduce) {
    .reel > li {
      transition: none;
    }
  }

  /* Story ----------------------------------------------------------------- */
  .story {
    padding-top: var(--section);
  }

  .story-grid {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  .story-photo {
    display: grid;
    gap: 0.6rem;
    width: min(100%, 26rem);
  }

  .story-copy {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  .story-copy h2 {
    font-size: var(--step-5);
  }


  @media (min-width: 900px) {
    .story-grid {
      grid-template-columns: 5fr 6fr;
    }
    .story-photo {
      justify-self: center;
    }
  }
</style>

<script>
  import { wantVideo } from '../scripts/motion';

  // The occasions reel: hovering or focusing a card opens it, and on wide
  // screens the open card plays its film while the reel is in view.
  const reel = document.querySelector<HTMLElement>('[data-reel]');
  if (reel) {
    const items = Array.from(reel.children) as HTMLElement[];
    const wide = matchMedia('(min-width: 1024px)');
    let open = items.find((li) => li.classList.contains('is-open')) ?? items[0];
    let visible = false;
    const sync = () => {
      if (!wide.matches) return;
      for (const li of items) {
        const v = li.querySelector<HTMLVideoElement>('video');
        if (v) wantVideo(v, visible && li === open);
      }
    };
    const openItem = (li: HTMLElement) => {
      if (li === open) return;
      open.classList.remove('is-open');
      li.classList.add('is-open');
      open = li;
      sync();
    };
    for (const li of items) {
      li.addEventListener('pointerenter', () => openItem(li));
      li.addEventListener('focusin', () => openItem(li));
    }
    const start = () =>
      new IntersectionObserver(
        ([e]) => {
          visible = e.isIntersecting;
          sync();
        },
        { threshold: 0.35 },
      ).observe(reel);
    if (document.readyState === 'complete') start();
    else addEventListener('load', start, { once: true });
  }
</script>
