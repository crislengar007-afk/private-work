---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site, hours } from '../data/site';
import { services } from '../data/services';
import { galleryItems, collectionLabel } from '../data/gallery';

const { contact } = site;
const tel = (n: string) => `tel:${n.replace(/[^+\d]/g, '')}`;

// Delivery: a configured form endpoint (PUBLIC_FORM_ENDPOINT) or, until one
// exists, a clearly labelled email draft. The preview never reports a
// submission it cannot confirm.
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT || '';
const mode = endpoint ? 'endpoint' : contact.email ? 'email' : 'unavailable';

// Small index of gallery items so an enquiry can carry the selected photograph.
const pieces = await Promise.all(
  galleryItems.map(async (item) => ({
    id: item.id,
    label: item.caption ?? item.alt,
    collection: collectionLabel(item.collection) ?? '',
    thumb: (await getImage({ src: item.image, width: 200, format: 'webp' })).src,
  })),
);

const serviceOptions = services.map((s) => ({ id: s.id, label: s.title, questions: s.questions ?? null }));
const today = new Date().toISOString().slice(0, 10);
---

<Base
  title="Contact"
  description="Request flowers or discuss an event with The Flower Studio TCI at Ports of Call, Grace Bay. Phone, email, opening hours and directions."
  dock={false}
>
  <section class="contact wrap" aria-labelledby="contact-title">
    <div class="aside">
      <h1 id="contact-title">Request <em>Flowers</em></h1>
      <p class="lede">
        For any enquiries or floral needs, get in touch with our floral artisans. Share the occasion and the feeling you
        have in mind, and we will take it from there.
      </p>

      <dl class="details">
        {
          contact.phone && (
            <div>
              <dt class="label">Telephone</dt>
              <dd>
                <a href={tel(contact.phone)}>{contact.phone}</a>
                {contact.landline && (
                  <>
                    <br />
                    <a href={tel(contact.landline)}>{contact.landline}</a> <span class="muted">(landline)</span>
                  </>
                )}
              </dd>
            </div>
          )
        }
        {
          contact.email && (
            <div>
              <dt class="label">Email</dt>
              <dd>
                <a href={`mailto:${contact.email}`}>{contact.email}</a>
              </dd>
            </div>
          )
        }
        <div>
          <dt class="label">Studio</dt>
          <dd>
            {contact.address}
            {
              contact.mapUrl && (
                <>
                  <br />
                  <a class="link" href={contact.mapUrl} rel="noopener">
                    Get directions <Icon name="arrow-right" class="arrow" />
                  </a>
                </>
              )
            }
          </dd>
        </div>
        <div>
          <dt class="label">Opening hours</dt>
          <dd>
            {
              hours.map((h) => (
                <span class="hours-row">
                  {h.days}: <span class="num">{h.time}</span>
                </span>
              ))
            }
          </dd>
        </div>
        {
          (contact.instagram || contact.facebook) && (
            <div>
              <dt class="label">Follow</dt>
              <dd class="social">
                {contact.instagram && (
                  <a href={`https://www.instagram.com/${contact.instagram}/`} rel="noopener">
                    Instagram
                  </a>
                )}
                {contact.facebook && (
                  <a href={contact.facebook} rel="noopener">
                    Facebook
                  </a>
                )}
              </dd>
            </div>
          )
        }
      </dl>
    </div>

    <form
      id="enquiry"
      class="form"
      novalidate
      data-enquiry
      data-mode={mode}
      data-endpoint={endpoint || undefined}
      data-email={contact.email ?? undefined}
      data-services={JSON.stringify(serviceOptions)}
      aria-labelledby="form-title"
    >
      <h2 id="form-title" class="form-title">Your enquiry</h2>

      {
        mode !== 'endpoint' && (
          <p class="setup-note" role="note">
            <strong>Preview:</strong> online delivery is not connected yet.
            {mode === 'email'
              ? ` “Compose email” opens your email app with this enquiry addressed to ${contact.email}. Nothing is sent until you send it there, and this page does not store your details.`
              : ' Please use the telephone or email details on this page.'}
          </p>
        )
      }

      <p class="required-note caption">All fields are required unless marked optional.</p>

      <div class="selection" data-selection hidden>
        <img class="selection-thumb" data-selection-thumb alt="" width="88" height="110" />
        <div class="selection-text">
          <p class="label">Your selection</p>
          <p class="selection-name" data-selection-name></p>
          <p class="selection-actions caption">
            <a href="/gallery/" data-selection-view>View in gallery</a>
            <button type="button" class="text-button" data-selection-remove>Remove</button>
          </p>
        </div>
        <input type="hidden" name="piece" data-selection-input />
      </div>

      <div class="field">
        <label for="f-name">Name</label>
        <input id="f-name" name="name" type="text" autocomplete="name" required aria-describedby="f-name-error" />
        <p class="error" id="f-name-error" data-error-for="name"></p>
      </div>

      <div class="field-row">
        <div class="field">
          <label for="f-email">Email</label>
          <input id="f-email" name="email" type="email" autocomplete="email" required aria-describedby="f-email-error" />
          <p class="error" id="f-email-error" data-error-for="email"></p>
        </div>
        <div class="field">
          <label for="f-phone">Telephone <span class="optional">(optional)</span></label>
          <input id="f-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" aria-describedby="f-phone-error" />
          <p class="error" id="f-phone-error" data-error-for="phone"></p>
        </div>
      </div>

      <div class="field-row">
        <div class="field">
          <label for="f-service">Service</label>
          <select id="f-service" name="service" required aria-describedby="f-service-error">
            <option value="">Choose a service</option>
            {serviceOptions.map((s) => <option value={s.id}>{s.label}</option>)}
            <option value="other">Something else</option>
          </select>
          <p class="error" id="f-service-error" data-error-for="service"></p>
        </div>
        <div class="field">
          <label for="f-date">Date needed <span class="optional">(optional)</span></label>
          <input id="f-date" name="date" type="date" min={today} aria-describedby="f-date-error" />
          <p class="error" id="f-date-error" data-error-for="date"></p>
        </div>
      </div>

      <fieldset class="event-fields" data-event-fields hidden>
        <legend>A little more detail <span class="optional">(optional)</span></legend>
        <div class="field">
          <label for="f-venue">Venue or location</label>
          <input id="f-venue" name="venue" type="text" autocomplete="off" />
        </div>
        <div class="field" data-q="wedding" hidden>
          <label for="f-guests">Approximate number of guests</label>
          <input id="f-guests" name="guests" type="number" min="1" max="2000" inputmode="numeric" />
        </div>
        <div class="field" data-q="hospitality" hidden>
          <label for="f-frequency">One-off or ongoing?</label>
          <select id="f-frequency" name="frequency">
            <option value="">Not sure yet</option>
            <option value="One-off">One-off</option>
            <option value="Ongoing">Ongoing (regular arrangements)</option>
          </select>
        </div>
      </fieldset>

      <div class="field">
        <label for="f-message">Tell us about it</label>
        <textarea id="f-message" name="message" rows="5" required minlength="10" aria-describedby="f-message-hint f-message-error"></textarea>
        <p class="hint" id="f-message-hint">The occasion, colours you love, the setting, anything that helps.</p>
        <p class="error" id="f-message-error" data-error-for="message"></p>
      </div>

      <!-- Spam trap: hidden from people and assistive tech; bots tend to fill it. -->
      <div class="trap" aria-hidden="true">
        <label for="f-website">Website</label>
        <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <div class="submit">
        <button class="button" type="submit" data-submit disabled={mode === 'unavailable'}>
          <span data-submit-label>{mode === 'email' ? 'Compose email' : 'Send enquiry'}</span>
          <Icon name="arrow-right" class="arrow" />
        </button>
      </div>

      <div class="status" data-status role="status" aria-live="polite" tabindex="-1"></div>
    </form>
  </section>

  <script type="application/json" id="pieces-data" set:html={JSON.stringify(pieces)} />
</Base>

<style>
  .form {
    scroll-margin-top: 5.5rem;
  }

  .contact {
    display: grid;
    gap: clamp(3rem, 7vw, 5rem);
    padding-block: clamp(2.5rem, 7vw, 6rem) var(--section);
  }

  .aside {
    display: grid;
    gap: 2rem;
    align-content: start;
  }

  h1 {
    font-size: var(--step-6);
  }

  .details {
    display: grid;
    gap: 1.4rem;
  }

  .details dd {
    margin-top: 0.3rem;
    font-size: var(--step-1);
  }

  .details a:not(.link) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration-color: var(--rule-strong);
  }

  .details a:hover {
    color: var(--lagoon);
  }

  .muted {
    color: var(--ink-soft);
    font-size: var(--step-0);
  }

  .hours-row {
    display: block;
  }

  .num {
    font-variant-numeric: tabular-nums;
  }

  .social {
    display: flex;
    gap: 1.5rem;
  }

  @media (min-width: 1024px) {
    .contact {
      grid-template-columns: 5fr 6fr;
      gap: clamp(3rem, 7vw, 7rem);
    }
    .aside {
      position: sticky;
      top: 6.5rem;
    }
  }

  /* Form -------------------------------------------------------------------- */
  .form {
    display: grid;
    gap: 1.6rem;
    align-content: start;
    padding: clamp(1.5rem, 4vw, 2.75rem);
    background: var(--stone-2);
    border: 1px solid var(--rule);
    border-radius: 1.25rem;
  }

  .form-title {
    font-size: var(--step-4);
  }

  .setup-note {
    padding: 1rem 1.25rem;
    border: 1px solid var(--rule-strong);
    border-radius: 0.75rem;
    background: var(--stone);
    font-size: 0.9375rem;
  }

  .required-note {
    margin-top: -0.5rem;
  }

  .field-row {
    display: grid;
    gap: 1.6rem;
  }

  @media (min-width: 640px) {
    .field-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .field {
    display: grid;
    gap: 0.45rem;
    align-content: start;
  }

  .field[hidden] {
    display: none;
  }

  label,
  legend {
    font-weight: 500;
    font-size: 0.9375rem;
  }

  .optional {
    font-weight: 400;
    color: var(--ink-soft);
  }

  input,
  select,
  textarea {
    width: 100%;
    min-height: 3.25rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--rule-strong);
    border-radius: 0.75rem;
    background: var(--stone);
    color: var(--ink);
    font-size: 1rem;
    transition:
      border-color var(--dur-1) var(--ease-out),
      background-color var(--dur-1) var(--ease-out);
  }

  select {
    appearance: none;
    background-image:
      linear-gradient(45deg, transparent 50%, currentColor 50%), linear-gradient(135deg, currentColor 50%, transparent 50%);
    background-position:
      calc(100% - 1.25rem) 55%,
      calc(100% - 0.95rem) 55%;
    background-size:
      0.3rem 0.3rem,
      0.3rem 0.3rem;
    background-repeat: no-repeat;
    padding-right: 2.5rem;
  }

  textarea {
    min-height: 8.5rem;
    resize: vertical;
    line-height: 1.55;
  }

  input:hover,
  select:hover,
  textarea:hover {
    border-color: var(--ink-soft);
  }

  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: 2px solid var(--lagoon);
    outline-offset: 0;
    border-color: var(--lagoon);
  }

  [aria-invalid='true'],
  [aria-invalid='true']:focus-visible {
    border-color: var(--lotus);
    outline-color: var(--lotus);
  }

  .hint {
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  .error {
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--lotus);
  }

  .error:empty {
    display: none;
  }

  .event-fields {
    display: grid;
    gap: 0.9rem;
    padding: 1.1rem 1.25rem 1.3rem;
    border: 1px solid var(--rule);
    border-radius: 0.75rem;
  }

  .event-fields[hidden] {
    display: none;
  }

  .trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .submit {
    display: grid;
    justify-items: start;
  }

  .status:empty {
    display: none;
  }

  .status {
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--rule-strong);
    border-radius: 0.75rem;
    background: var(--stone);
  }

  .status[data-tone='error'] {
    border-color: var(--lotus);
  }

  .status[data-tone='success'] {
    border-color: var(--lagoon);
  }

  .status :global(p + p) {
    margin-top: 0.5rem;
  }

  .status:focus {
    outline: none;
  }

  /* Selected gallery item ----------------------------------------------------- */
  .selection {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 1.1rem;
    align-items: center;
    padding: 0.85rem;
    border: 1px solid var(--rule);
    border-radius: 0.75rem;
    background: var(--stone);
  }

  .selection[hidden] {
    display: none;
  }

  .selection-thumb {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 999px 999px 0 0;
    background: var(--sand);
  }

  .selection-name {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.2;
    margin-block: 0.1rem 0.2rem;
  }

  .selection-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
  }

  .selection-actions a,
  .text-button {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink);
  }

  .text-button {
    padding: 0;
    border: 0;
    background: none;
    text-decoration: underline;
    text-underline-offset: 0.22em;
    text-decoration-thickness: 1px;
  }
</style>

<script>
  import { initEnquiry } from '../scripts/contact';
  initEnquiry();
</script>
