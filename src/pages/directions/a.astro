---
// Direction A: Botanical Editorial. Concept homepage for comparison only.
import '@fontsource-variable/bodoni-moda/opsz.css';
import '@fontsource-variable/bodoni-moda/opsz-italic.css';
import '@fontsource-variable/geist';
import { Picture } from 'astro:assets';
import { galleryItems } from '../../data/gallery';
import { services, mission } from '../../data/services';
import { site } from '../../data/site';
import { decor } from '../../data/decor';

const hero = decor('hero-petals');
const [p1, p2, p3] = galleryItems;
---

<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Direction A: Botanical Editorial | The Flower Studio TCI</title>
  </head>
  <body>
    <header class="bar">
      <span class="brand">The Flower Studio <small>TCI</small></span>
      <nav><a href="#">Services</a><a href="#">Gallery</a><a href="#">Contact</a><a class="cta" href="#">Request flowers</a></nav>
    </header>

    <section class="hero">
      <div class="copy">
        <h1>Bringing flower elegance to your island <em>experience.</em></h1>
        <p>Arrangements, wedding decoration and hospitality florals from our studio at Ports of Call, Turks and Caicos.</p>
        <div class="actions"><a class="btn" href="#">Explore the gallery</a><a class="ln" href="#">Request flowers</a></div>
      </div>
      <div class="media">{hero && <Picture src={hero.image} alt="" widths={[800, 1400]} sizes="60vw" formats={['webp']} />}</div>
    </section>

    <section class="index">
      <h2>Services</h2>
      <ul>{services.map((s) => <li><span class="t">{s.title}</span><span class="d">{s.summary}</span></li>)}</ul>
    </section>

    <section class="work">
      {[p1, p2, p3].map((p, i) => p?.image && (
        <figure class={`w${i}`}><Picture src={p.image} alt={p.alt} widths={[480, 900]} sizes="40vw" formats={['webp']} /><figcaption>{p.caption}</figcaption></figure>
      ))}
      <blockquote>{mission}</blockquote>
    </section>

    <section class="band"><h2>Create something beautiful together.</h2><p>{site.contact.phone} &nbsp;/&nbsp; {site.contact.email}</p></section>
  </body>
</html>

<style is:global>
  :root { --paper:#f3f1ea; --ink:#17221c; --soft:#48574e; --green:#1e3a2d; --rose:#8a4753; }
  * { box-sizing:border-box; margin:0 }
  body { background:var(--paper); color:var(--ink); font:17px/1.6 'Geist Variable', system-ui, sans-serif; }
  img { display:block; width:100%; height:100%; object-fit:cover }
  picture { display:block; min-width:0; height:100% }
  h1,h2,.t,blockquote { font-family:'Bodoni Moda Variable', Didot, serif; font-weight:400; letter-spacing:-.02em; text-wrap:balance; line-height:1.08 }
  .bar { display:flex; justify-content:space-between; align-items:center; padding:1.25rem clamp(1rem,4vw,3.5rem) }
  .brand { font-family:'Bodoni Moda Variable', serif; font-size:1.3rem } .brand small { font:500 .7rem 'Geist Variable'; letter-spacing:.2em; color:var(--soft) }
  nav { display:flex; gap:2rem; align-items:center; font-size:.95rem } nav a { color:inherit; text-decoration:none } .cta { background:var(--green); color:var(--paper)!important; padding:.7rem 1.1rem }
  .hero { display:grid; grid-template-columns:5fr 7fr; gap:3rem; min-height:82vh; align-items:center; padding-left:clamp(1rem,4vw,3.5rem) }
  h1 { font-size:clamp(2.8rem,5.4vw,5.6rem); line-height:1.02 } h1 em { font-style:italic }
  .copy p { margin:1.5rem 0 2rem; color:var(--soft); max-width:30rem; font-size:1.15rem }
  .actions { display:flex; gap:2rem; align-items:center } .btn { background:var(--green); color:var(--paper); padding:1rem 1.5rem; text-decoration:none } .ln { color:inherit }
  .media { height:82vh }
  .index { display:grid; grid-template-columns:4fr 8fr; gap:2rem; padding:8rem clamp(1rem,4vw,3.5rem) } .index h2 { font-size:3.6rem }
  .index ul { list-style:none; padding:0; border-bottom:1px solid #17221c29 } .index li { display:grid; grid-template-columns:5fr 4fr; gap:1.5rem; padding:1.4rem 0; border-top:1px solid #17221c29; align-items:baseline }
  .t { font-size:2.1rem } .d { color:var(--soft) }
  .work { display:grid; grid-template-columns:repeat(12,1fr); gap:1.5rem; padding:0 clamp(1rem,4vw,3.5rem) 8rem; align-items:start }
  figure { display:grid; gap:.6rem } figcaption { font-size:.8rem; color:var(--soft) }
  .w0 { grid-column:1/span 5; aspect-ratio:4/5 } .w1 { grid-column:7/span 3; margin-top:8rem; aspect-ratio:3/4 } .w2 { grid-column:10/span 3; margin-top:2rem; aspect-ratio:1 }
  blockquote { grid-column:6/span 6; font-size:1.9rem; line-height:1.25; margin-top:2rem; font-style:italic }
  .band { background:var(--green); color:var(--paper); padding:7rem clamp(1rem,4vw,3.5rem); display:grid; gap:1.5rem } .band h2 { font-size:clamp(2.4rem,4.5vw,4.4rem); max-width:14ch }
  @media (max-width:760px) {
    nav a:not(.cta) { display:none } .hero { grid-template-columns:1fr; padding:0 } .copy { padding:2rem 1rem } .media { height:60vh }
    .index { grid-template-columns:1fr; padding:5rem 1rem } .index li { grid-template-columns:1fr; gap:.3rem }
    .work { display:grid; grid-template-columns:1fr; padding:0 1rem 5rem } .w0,.w1,.w2,blockquote { grid-column:1; margin-top:0 } .w1 { width:70%; justify-self:end }
  }
</style>
