---
// Direction C: Minimal Floral Gallery. Concept homepage for comparison only.
import '@fontsource-variable/schibsted-grotesk';
import { Picture } from 'astro:assets';
import { galleryItems } from '../../data/gallery';
import { services } from '../../data/services';
import { site } from '../../data/site';

const tri = galleryItems.filter((g) => g.image && g.ratio < 0.8).slice(0, 3);
const more = galleryItems.filter((g) => g.image && g.ratio >= 0.9).slice(0, 4);
---

<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Direction C: Minimal Floral Gallery | The Flower Studio TCI</title>
  </head>
  <body>
    <header class="bar">
      <span class="brand">the flower studio</span>
      <nav><a href="#">Services</a><a href="#">Gallery</a><a href="#">Contact</a><a class="cta" href="#">Request flowers</a></nav>
    </header>

    <section class="hero">
      <div class="tri">{tri.map((p) => p.image && <Picture src={p.image} alt={p.alt} widths={[400, 800]} sizes="33vw" formats={['webp']} />)}</div>
      <div class="copy">
        <h1>Bringing flower elegance to your island experience.</h1>
        <div class="actions"><a class="btn" href="#">Explore the gallery</a><a href="#">Request flowers</a></div>
      </div>
    </section>

    <section class="list">
      {services.map((s) => <a href="#"><span>{s.title}</span><span class="d">{s.summary}</span></a>)}
    </section>

    <section class="grid">{more.map((p) => p.image && <figure><Picture src={p.image} alt={p.alt} widths={[400, 700]} sizes="25vw" formats={['webp']} /><figcaption>{p.caption}</figcaption></figure>)}</section>

    <footer class="foot"><p>{site.contact.address}</p><p>{site.contact.phone} &middot; {site.contact.email}</p></footer>
  </body>
</html>

<style is:global>
  :root { --bg:#f7f7f5; --ink:#111413; --soft:#5a5f5c; }
  * { box-sizing:border-box; margin:0 }
  body { background:var(--bg); color:var(--ink); font:16px/1.6 'Schibsted Grotesk Variable', system-ui, sans-serif }
  img { display:block; width:100%; height:100%; object-fit:cover } a { color:inherit }
  picture { display:block; min-width:0; height:100% }
  .bar { display:flex; justify-content:space-between; align-items:center; padding:1.25rem clamp(1rem,3vw,2.5rem); border-bottom:1px solid #1114131a }
  .brand { font-weight:600; letter-spacing:-.02em } nav { display:flex; gap:1.75rem; font-size:.9rem } nav a { text-decoration:none } .cta { text-decoration:underline!important }
  .tri { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:4px; height:72vh; overflow:hidden }
  .copy { display:flex; justify-content:space-between; align-items:end; gap:2rem; padding:2.5rem clamp(1rem,3vw,2.5rem) 5rem }
  h1 { font-size:clamp(2.2rem,4.2vw,4.4rem); line-height:1; letter-spacing:-.045em; font-weight:600; max-width:18ch }
  .actions { display:flex; gap:1.5rem; align-items:center; white-space:nowrap } .btn { background:var(--ink); color:var(--bg); padding:.85rem 1.3rem; text-decoration:none }
  .list { display:grid; border-top:1px solid #11141322 } .list a { display:grid; grid-template-columns:1fr 1fr; padding:1.35rem clamp(1rem,3vw,2.5rem); border-bottom:1px solid #11141322; text-decoration:none; font-size:1.4rem; letter-spacing:-.02em; font-weight:500 } .list .d { font-size:1rem; color:var(--soft); font-weight:400 }
  .grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:4px; padding:5rem 0 } figure { aspect-ratio:1 } figcaption { font-size:.75rem; color:var(--soft); padding:.4rem .6rem }
  .foot { display:flex; justify-content:space-between; padding:3rem clamp(1rem,3vw,2.5rem); border-top:1px solid #11141322; color:var(--soft); font-size:.9rem }
  @media (max-width:760px) {
    nav a:not(.cta) { display:none } .tri { height:auto; grid-template-columns:1fr 1fr } .tri picture:first-child { grid-column:1/-1 } .tri img { aspect-ratio:9/12 }
    .copy { flex-direction:column; align-items:start; padding:2rem 1rem 4rem } .list a { grid-template-columns:1fr; padding:1.2rem 1rem } .grid { grid-template-columns:repeat(2,minmax(0,1fr)) } .foot { flex-direction:column; gap:.5rem; padding:2rem 1rem }
  }
</style>
