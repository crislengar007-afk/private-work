---
// Direction B: Island Atelier. Concept homepage for comparison only.
import '@fontsource-variable/cormorant-garamond';
import '@fontsource-variable/cormorant-garamond/wght-italic.css';
import '@fontsource-variable/hanken-grotesk';
import { Picture, getImage } from 'astro:assets';
import { galleryItems } from '../../data/gallery';
import { services, mission } from '../../data/services';
import { site } from '../../data/site';
import { decor, heroVideo } from '../../data/decor';
import logo from '../../assets/brand/tfstci_logo-1.png';

const hero = decor('hero-petals');
const poster = hero ? await getImage({ src: hero.image, width: 1400, format: 'webp' }) : undefined;
const video = heroVideo();
const picks = galleryItems.slice(0, 5);
---

<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Direction B: Island Atelier | The Flower Studio TCI</title>
  </head>
  <body>
    <header class="bar">
      <img class="logo" src={logo.src} width="200" height="30" alt="The Flower Studio" />
      <nav><a href="#">Services</a><a href="#">Gallery</a><a href="#">Contact</a><a class="cta" href="#">Request flowers</a></nav>
    </header>

    <section class="hero">
      <div class="copy">
        <p class="place">Ports of Call &middot; Grace Bay</p>
        <h1>Bringing flower elegance to your <em>island</em> experience</h1>
        <p class="lede">Arrangements, weddings and hospitality florals, composed by hand in the Turks and Caicos Islands.</p>
        <div class="actions"><a class="btn" href="#">Explore the gallery</a><a class="btn ghost" href="#">Request flowers</a></div>
      </div>
      <div class="arch">
        {video ? <video src={video} poster={poster?.src} autoplay muted loop playsinline /> : poster && <img src={poster.src} alt="" />}
      </div>
    </section>

    <section class="services">
      <h2>For every occasion on the island</h2>
      <ul>{services.map((s) => <li><span class="t">{s.title}</span><span class="d">{s.summary}</span><span class="go">Enquire</span></li>)}</ul>
    </section>

    <section class="work">
      <div class="work-head"><h2>From the studio</h2><a href="#">Explore the gallery</a></div>
      <div class="strip">{picks.map((p, i) => p.image && (
        <figure class={i === 0 ? 'lead' : ''}><div class="ph"><Picture src={p.image} alt={p.alt} widths={[400, 800]} sizes="30vw" formats={['webp']} /></div><figcaption>{p.caption}</figcaption></figure>
      ))}</div>
    </section>

    <section class="story"><p class="q">{mission}</p><p class="by">Our story began in March 2023 at Ports of Call.</p></section>

    <section class="invite">
      <h2>Create something beautiful together</h2>
      <p><a href="#">{site.contact.phone}</a> &nbsp; <a href="#">{site.contact.email}</a></p>
      <a class="btn" href="#">Request flowers</a>
    </section>
  </body>
</html>

<style is:global>
  :root { --stone:#ece7de; --sand:#ddd5c7; --ink:#1d2627; --soft:#4d5856; --lagoon:#11696c; --lotus:#c4527a; }
  * { box-sizing:border-box; margin:0 }
  body { background:var(--stone); color:var(--ink); font:17px/1.65 'Hanken Grotesk Variable', system-ui, sans-serif }
  img, video { display:block; width:100%; height:100%; object-fit:cover }
  picture { display:block; min-width:0; height:100% }
  h1,h2,.t,.q { font-family:'Cormorant Garamond Variable', Garamond, serif; font-weight:400; letter-spacing:-.01em; text-wrap:balance; line-height:1.08 }
  a { color:inherit }
  .bar { display:flex; justify-content:space-between; align-items:center; padding:1.25rem clamp(1rem,4vw,3.5rem) } .logo { width:200px; height:auto; object-fit:contain }
  nav { display:flex; gap:2rem; align-items:center; font-size:.95rem } nav a { text-decoration:none } .cta { border:1px solid var(--lagoon); color:var(--lagoon); padding:.6rem 1.1rem; border-radius:999px }
  .hero { display:grid; grid-template-columns:6fr 5fr; gap:4rem; align-items:end; padding:2rem clamp(1rem,4vw,3.5rem) 0 }
  .place { font-size:.8rem; letter-spacing:.18em; text-transform:uppercase; color:var(--lotus); margin-bottom:1.5rem }
  h1 { font-size:clamp(3rem,6vw,6.4rem); line-height:.98; font-weight:300 } h1 em { color:var(--lagoon) }
  .lede { margin:1.75rem 0 2.25rem; max-width:30rem; color:var(--soft); font-size:1.15rem }
  .actions { display:flex; gap:1rem; flex-wrap:wrap; padding-bottom:5rem }
  .btn { display:inline-block; background:var(--lagoon); color:#f6f3ee; padding:.95rem 1.6rem; border-radius:999px; text-decoration:none } .ghost { background:transparent; color:var(--ink); border:1px solid #1d262766 }
  .arch { height:78vh; border-radius:999px 999px 0 0; overflow:hidden; background:var(--sand) }
  .services { padding:8rem clamp(1rem,4vw,3.5rem); background:var(--sand) } .services h2 { font-size:clamp(2.4rem,4vw,3.8rem); max-width:16ch; margin-bottom:3rem }
  .services ul { list-style:none; padding:0; display:grid; grid-template-columns:repeat(5,1fr); gap:1px; background:#1d262722 }
  .services li { background:var(--sand); padding:1.75rem 1.25rem 1.5rem; display:grid; gap:.75rem; align-content:start; min-height:15rem }
  .t { font-size:1.75rem; line-height:1.1 } .d { color:var(--soft); font-size:.95rem } .go { margin-top:auto; color:var(--lagoon); font-size:.9rem }
  .work { padding:8rem clamp(1rem,4vw,3.5rem) } .work-head { display:flex; justify-content:space-between; align-items:baseline; margin-bottom:2.5rem } .work-head h2 { font-size:3.4rem }
  .strip { display:grid; grid-template-columns:1.4fr 1fr 1fr 1fr 1fr; gap:1rem; align-items:end }
  .ph { aspect-ratio:3/4; overflow:hidden; border-radius:999px 999px 0 0 } .lead .ph { aspect-ratio:4/5 } figcaption { font-size:.8rem; color:var(--soft); margin-top:.6rem }
  .story { padding:4rem clamp(1rem,4vw,3.5rem) 8rem; max-width:62rem; margin:auto; text-align:center } .q { font-size:clamp(1.8rem,3vw,2.7rem); line-height:1.25; font-style:italic } .by { margin-top:1.5rem; color:var(--soft) }
  .invite { background:var(--lagoon); color:#f6f3ee; padding:7rem clamp(1rem,4vw,3.5rem); display:grid; gap:1.5rem; justify-items:start } .invite h2 { font-size:clamp(2.6rem,5vw,4.8rem); font-weight:300; max-width:14ch } .invite .btn { background:#f6f3ee; color:var(--lagoon) }
  @media (max-width:760px) {
    nav a:not(.cta) { display:none } .logo { width:150px } .hero { grid-template-columns:1fr; gap:2rem; padding:1rem 1rem 0 } .actions { padding-bottom:0 } .arch { height:62vh }
    .services { padding:5rem 1rem } .services ul { grid-template-columns:1fr } .services li { min-height:0 }
    .work { padding:5rem 1rem } .strip { grid-template-columns:repeat(5,70%); overflow-x:auto; scroll-snap-type:x mandatory } .strip figure { scroll-snap-align:start }
  }
</style>
