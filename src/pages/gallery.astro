---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import MotionPhoto from '../components/MotionPhoto.astro';
import Icon from '../components/Icon.astro';
import InquiryBand from '../components/InquiryBand.astro';
import { galleryItems, collections, collectionLabel } from '../data/gallery';

// Full-size sources for the viewer, generated at build time and never wider
// than the original photograph.
const viewerData = await Promise.all(
  galleryItems.map(async (item) => {
    const widths = [800, 1200, 1600].filter((w) => w < item.width);
    widths.push(item.width);
    const variants = await Promise.all(widths.map((w) => getImage({ src: item.image, width: w, format: 'webp' })));
    return {
      id: item.id,
      alt: item.alt,
      caption: item.caption ?? '',
      collection: item.collection ?? '',
      collectionLabel: collectionLabel(item.collection) ?? '',
      width: item.width,
      height: item.height,
      src: variants[variants.length - 1].src,
      srcset: variants.map((v, i) => `${v.src} ${widths[i]}w`).join(', '),
      motion: item.motion,
    };
  }),
);

const orient = (r: number) => (r > 1.08 ? 'landscape' : r < 0.92 ? 'portrait' : 'square');
---

<Base
  title="Gallery"
  description="Floral arrangements by The Flower Studio TCI at Ports of Call, Grace Bay. Browse the studio's own work and enquire about any arrangement."
>
  <section class="intro wrap" aria-labelledby="gallery-title">
    <h1 id="gallery-title">Gallery</h1>
    <div class="intro-copy">
      <p class="lede">
        Every photograph here is the studio’s own work. Open any arrangement to see it in full, then enquire about
        something similar for your occasion.
      </p>
      <p class="caption">
        A few photographs move: that gentle motion was added digitally with Higgsfield and is labelled on each one. The
        arrangements themselves are unchanged.
      </p>
    </div>
  </section>

  <section class="wrap gallery" aria-label="Photographs" data-gallery>
    {
      collections.length > 0 && (
        <div class="filters" data-filters>
          <div class="filter-group" role="group" aria-label="Filter by colour">
            <button type="button" class="filter" data-filter="" data-label="All" aria-pressed="true">
              All <span class="count">{galleryItems.length}</span>
            </button>
            {collections.map((c) => (
              <button type="button" class="filter" data-filter={c.id} data-label={c.label} aria-pressed="false">
                {c.label} <span class="count">{c.count}</span>
              </button>
            ))}
          </div>
          <p class="filter-status caption" aria-live="polite" data-filter-status>
            {galleryItems.length} photographs
          </p>
        </div>
      )
    }

    <ul class="grid" data-grid>
      {
        galleryItems.map((item, i) => (
          <li class="item is-shown" data-id={item.id} data-collection={item.collection ?? ''} data-orient={orient(item.ratio)}>
            <button
              type="button"
              class="thumb"
              data-open={item.id}
              aria-haspopup="dialog"
              aria-label={`View larger: ${item.alt}`}
            >
              <MotionPhoto
                item={item}
                sizes={item.ratio < 0.92 ? '(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 90vw' : '(min-width: 640px) 512px, 90vw'}
                eager={i < 2}
              />
            </button>
            <p class="caption item-caption">
              {item.caption}
              {item.collection && <span class="item-collection">{collectionLabel(item.collection)}</span>}
            </p>
          </li>
        ))
      }
    </ul>

    <p class="empty" data-empty hidden>No photographs in this colour yet.</p>
  </section>

  <dialog class="viewer" data-viewer aria-labelledby="viewer-title">
    <h2 id="viewer-title" class="visually-hidden">Photograph viewer</h2>
    <div class="viewer-bar">
      <p class="viewer-count" data-count aria-live="polite"></p>
      <div class="viewer-tools">
        <button type="button" class="viewer-tool" data-fullscreen aria-pressed="false" hidden>
          <span data-fullscreen-label>Full screen</span>
        </button>
        <button type="button" class="viewer-close" data-close autofocus>
          Close <Icon name="x" />
        </button>
      </div>
    </div>

    <div class="viewer-stage" data-stage>
      <button type="button" class="viewer-nav prev" data-prev aria-label="Previous photograph">
        <Icon name="arrow-left" />
      </button>
      <figure class="viewer-figure" data-figure>
        <img data-img alt="" decoding="async" hidden />
        <video data-viewer-video muted loop playsinline preload="none" aria-hidden="true" tabindex="-1" hidden></video>
      </figure>
      <button type="button" class="viewer-nav next" data-next aria-label="Next photograph">
        <Icon name="arrow-right" />
      </button>
    </div>

    <div class="viewer-foot">
      <div class="viewer-text">
        <p class="viewer-caption" data-caption></p>
        <p class="viewer-motion" data-motion-note hidden>
          <span>Motion added digitally to the studio’s photograph.</span>
          <button type="button" class="viewer-motion-toggle" data-motion-switch aria-pressed="true">Show the still photograph</button>
        </p>
      </div>
      <a class="link viewer-enquire" data-enquire href="/contact/">
        Enquire about this arrangement <Icon name="arrow-right" class="arrow" />
      </a>
    </div>
  </dialog>

  <script type="application/json" id="gallery-data" set:html={JSON.stringify(viewerData)} />

  <InquiryBand text="Seen an arrangement you love? Mention it in your enquiry, or use the link beside any photograph to bring it with you." />
</Base>

<style>
  .intro {
    display: grid;
    gap: 1.5rem;
    padding-block: clamp(2.5rem, 7vw, 6rem) clamp(2rem, 4vw, 3.5rem);
  }

  .intro h1 {
    font-size: var(--step-6);
  }

  @media (min-width: 1024px) {
    .intro {
      grid-template-columns: 6fr 5fr;
      align-items: end;
      gap: 4rem;
    }
    .intro-copy {
      padding-bottom: 1rem;
    }
  }

  .gallery {
    padding-bottom: var(--section);
    scroll-margin-top: 5.5rem;
  }

  /* Filters ------------------------------------------------------------------ */
  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
    padding-block: 0.75rem;
    border-block: 1px solid var(--rule);
  }

  .filter-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filter {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    min-width: 44px;
    padding: 0 1.1rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--pill);
    background: transparent;
    font-size: 0.9688rem;
    transition:
      background-color var(--dur-1) var(--ease-out),
      border-color var(--dur-1) var(--ease-out),
      color var(--dur-1) var(--ease-out);
  }

  .filter:hover {
    border-color: var(--ink);
  }

  .filter[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--stone);
  }

  .count {
    font-size: 0.8125rem;
    opacity: 0.7;
    font-variant-numeric: tabular-nums;
  }

  /* Editorial grid --------------------------------------------------------------
     The rhythm follows the position among *visible* items, so filtering keeps
     the composition. Squares are the studio's 512px originals and are never
     enlarged beyond that (Media native). */
  .grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2vw, 2rem);
    row-gap: clamp(2.5rem, 6vw, 5.5rem);
    align-items: start;
  }

  .item {
    grid-column: 1 / -1;
    display: grid;
    gap: 0.75rem;
    justify-items: start;
  }

  .item[hidden] {
    display: none;
  }

  .item:nth-child(even of .is-shown) {
    grid-column: 3 / -1;
    justify-items: end;
  }

  .item:nth-child(even of .is-shown) .item-caption {
    justify-self: end;
  }

  @media (min-width: 640px) {
    .item:nth-child(odd of .is-shown) {
      grid-column: 1 / span 6;
      justify-items: start;
    }
    .item:nth-child(even of .is-shown) {
      grid-column: 7 / span 6;
      margin-top: clamp(3rem, 12vw, 8rem);
      justify-items: start;
    }
    .item:nth-child(even of .is-shown) .item-caption {
      justify-self: start;
    }
  }

  @media (min-width: 1024px) {
    .item:nth-child(3n + 1 of .is-shown) {
      grid-column: 1 / span 4;
      margin-top: 0;
    }
    .item:nth-child(3n + 2 of .is-shown) {
      grid-column: 5 / span 4;
      margin-top: clamp(4rem, 9vw, 9rem);
    }
    .item:nth-child(3n of .is-shown) {
      grid-column: 9 / span 4;
      margin-top: clamp(1.5rem, 4vw, 4rem);
    }
    .item[data-orient='portrait'] .thumb {
      max-width: 26rem;
    }
  }

  .thumb {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    text-align: inherit;
    cursor: zoom-in;
  }

  .thumb :global(.frame) {
    width: 100%;
  }

  .item-caption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
  }

  .item-collection {
    color: var(--lagoon);
  }

  .empty {
    padding-block: 4rem;
    color: var(--ink-soft);
  }

  /* Viewer -------------------------------------------------------------------- */
  .viewer {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--scrim);
    color: #ece9e0;
    overscroll-behavior: contain;
  }

  .viewer[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
  }

  .viewer::backdrop {
    background: var(--scrim);
  }

  @media (prefers-reduced-motion: no-preference) {
    .viewer[open] {
      animation: viewer-in 420ms var(--ease-out);
    }
  }

  @keyframes viewer-in {
    from {
      opacity: 0;
    }
  }

  .viewer :focus-visible {
    outline-color: #6cc3c4;
  }

  .viewer-bar,
  .viewer-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding: 0.75rem var(--gutter);
  }

  .viewer-count {
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    color: #b8c0b8;
  }

  .viewer-tools {
    display: flex;
    align-items: center;
    gap: 0.5rem 1.25rem;
  }

  .viewer-tool,
  .viewer-motion-toggle {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 1rem;
    border: 1px solid rgb(236 233 224 / 0.3);
    border-radius: var(--pill);
    background: transparent;
    color: inherit;
    font-size: 0.875rem;
    transition: border-color var(--dur-1) var(--ease-out);
  }

  .viewer-tool:hover,
  .viewer-motion-toggle:hover {
    border-color: #ece9e0;
  }

  .viewer-text {
    display: grid;
    gap: 0.25rem;
  }

  .viewer-motion {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.75rem;
    font-size: 0.8125rem;
    color: #b8c0b8;
  }

  .viewer-motion[hidden] {
    display: none;
  }

  .viewer-motion-toggle {
    min-height: 36px;
    padding: 0 0.8rem;
    font-size: 0.8125rem;
  }

  .viewer:fullscreen {
    background: #0b0f0e;
  }

  .viewer-close {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 44px;
    padding: 0 0.25rem;
    border: 0;
    background: none;
    color: inherit;
    font-size: 0.9375rem;
  }

  .viewer-stage {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    min-height: 0;
    height: 100%;
    touch-action: pan-y pinch-zoom;
    user-select: none;
  }

  .viewer-figure {
    position: relative;
    height: 100%;
    min-height: 0;
    overflow: hidden;
    margin: 0 0.5rem;
  }

  /* The photograph is contained within the stage and never enlarged past
     its own pixels (max sizes are set per image by the script). */
  .viewer-figure img {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition:
      opacity 320ms var(--ease-out),
      transform 520ms var(--ease-out);
  }

  .viewer-figure video {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    transition: opacity 600ms var(--ease-out);
    pointer-events: none;
  }

  .viewer-figure video.is-playing {
    opacity: 1;
  }

  .viewer-figure.is-changing img,
  .viewer-figure.is-changing video {
    opacity: 0;
  }

  .viewer-figure.is-changing[data-dir='next'] img {
    transform: translateX(-1.5rem);
  }

  .viewer-figure.is-changing[data-dir='prev'] img {
    transform: translateX(1.5rem);
  }

  .viewer-nav {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    margin-inline: clamp(0.25rem, 2vw, 1.5rem);
    border: 1px solid rgb(236 233 224 / 0.3);
    background: transparent;
    color: inherit;
    font-size: 1.25rem;
    transition:
      border-color var(--dur-1) var(--ease-out),
      background-color var(--dur-1) var(--ease-out);
  }

  .viewer-nav:hover {
    border-color: #ece9e0;
    background: rgb(236 233 224 / 0.08);
  }

  .viewer-caption {
    font-size: 0.9375rem;
    color: #d6dad3;
    max-width: 42rem;
  }

  .viewer-enquire {
    color: #ece9e0;
    white-space: nowrap;
  }

  .viewer-enquire:hover {
    color: #6cc3c4;
  }

  @media (max-width: 767px) {
    /* Controls sit in their own row so they never cover the photograph. */
    .viewer-stage {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: minmax(0, 1fr) auto;
      row-gap: 0.75rem;
    }
    .viewer-figure {
      grid-column: 1 / -1;
      grid-row: 1;
      height: 100%;
      margin: 0;
    }
    .viewer-nav {
      grid-row: 2;
      width: 3rem;
      height: 3rem;
      margin: 0;
    }
    .viewer-nav.prev {
      grid-column: 1;
      justify-self: start;
      margin-left: var(--gutter);
    }
    .viewer-nav.next {
      grid-column: 2;
      justify-self: end;
      margin-right: var(--gutter);
    }
    .viewer-foot {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
      padding-bottom: max(1rem, env(safe-area-inset-bottom));
    }
  }
</style>

<script>
  import { initGallery } from '../scripts/gallery';
  initGallery();
</script>
