---
/**
 * Compact contact actions on small screens. It sits in its own space at the
 * foot of the viewport; the page reserves matching padding so no content is
 * ever covered. Hidden on the Contact page, where the details are primary.
 */
import { site } from '../data/site';
const phone = site.contact.phone;
---

{
  phone && (
    <div class="dock" data-dock>
      <a class="call" href={`tel:${phone.replace(/[^+\d]/g, '')}`}>Call the studio</a>
      <a class="button request" href="/contact/">Request Flowers</a>
    </div>
  )
}

<style>
  .dock {
    display: none;
  }
  @media (max-width: 860px) {
    :global(body:has(.dock)) {
      padding-bottom: calc(4.5rem + env(safe-area-inset-bottom, 0px));
    }
    .dock {
      position: fixed;
      inset: auto 0 0 0;
      z-index: var(--z-dock);
      display: grid;
      grid-template-columns: 1fr 1.3fr;
      gap: 0.5rem;
      padding: 0.6rem var(--gutter) calc(0.6rem + env(safe-area-inset-bottom, 0px));
      background: color-mix(in srgb, var(--stone) 96%, transparent);
      border-top: 1px solid var(--rule);
      -webkit-backdrop-filter: blur(10px);
      backdrop-filter: blur(10px);
    }
    .call {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 3.1rem;
      border: 1px solid var(--rule-strong);
      border-radius: var(--pill);
      text-decoration: none;
      font-weight: 500;
      font-size: 0.9375rem;
    }
    .request {
      min-height: 3.1rem;
      padding-inline: 1rem;
    }
    .dock {
      transition:
        transform var(--dur-2) var(--ease-out),
        visibility 0s linear 0s;
    }
    .dock.is-tucked {
      transform: translateY(110%);
      visibility: hidden;
      transition:
        transform var(--dur-2) var(--ease-out),
        visibility 0s linear var(--dur-2);
    }
  }
</style>

<script>
  // Stay out of the way while the page's own primary actions are on screen.
  const dock = document.querySelector<HTMLElement>('[data-dock]');
  const primary = document.querySelector('[data-dock-hide]');
  if (dock && primary && 'IntersectionObserver' in window) {
    dock.classList.add('is-tucked');
    new IntersectionObserver(([entry]) => dock.classList.toggle('is-tucked', entry.isIntersecting)).observe(primary);
  }
</script>
