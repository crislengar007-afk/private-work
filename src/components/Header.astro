---
import Logo from './Logo.astro';
import { nav, site, hours } from '../data/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<div class="header-sentinel" data-header-sentinel aria-hidden="true"></div>
<header class="site-header" data-header>
  <div class="bar">
    <a class="brand" href="/" aria-label="The Flower Studio TCI, home"><Logo width={196} /></a>

    <nav class="primary" aria-label="Primary">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="button header-cta" href="/contact/">Request Flowers</a>
    </nav>

    <button class="menu-toggle" type="button" aria-haspopup="dialog" aria-controls="site-menu" aria-expanded="false" data-menu-open>
      <span>Menu</span>
      <span class="lines" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>
</header>

<dialog class="menu" id="site-menu" aria-label="Site menu" data-menu>
  <div class="menu-top">
    <a class="brand" href="/" aria-label="The Flower Studio TCI, home"><Logo width={170} /></a>
    <button class="menu-close" type="button" data-menu-close autofocus>
      <span>Close</span>
      <span class="lines is-x" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>
  <nav aria-label="Menu">
    <ul>
      <li style="--i: 0"><a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a></li>
      {
        nav.map((item, i) => (
          <li style={`--i: ${i + 1}`}>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <a class="button menu-cta" href="/contact/">Request Flowers</a>
  <div class="menu-facts">
    {site.contact.phone && <a href={`tel:${site.contact.phone.replace(/[^+\d]/g, '')}`}>{site.contact.phone}</a>}
    <p>{hours.map((h) => <span>{h.days}, {h.time}</span>)}</p>
  </div>
</dialog>

<style>
  .header-sentinel {
    position: absolute;
    top: 0;
    height: 1px;
    width: 1px;
  }

  .site-header {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: var(--z-header);
    padding: 0.75rem calc(var(--gutter) - 1.25rem) 0;
    pointer-events: none;
  }

  .bar {
    pointer-events: auto;
    max-width: calc(var(--max) - 2 * var(--gutter) + 2.5rem);
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    min-height: 4rem;
    padding: 0.4rem 0.6rem 0.4rem 1.25rem;
    border: 1px solid transparent;
    border-radius: var(--pill);
    transition:
      background-color var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out),
      box-shadow var(--dur-2) var(--ease-out);
  }

  /* Once the page scrolls, the bar settles into a floating limestone pill. */
  .site-header.is-floating .bar {
    background: color-mix(in srgb, var(--stone) 94%, transparent);
    border-color: var(--rule);
    box-shadow: 0 10px 30px -18px rgb(29 38 39 / 0.35);
    -webkit-backdrop-filter: blur(12px) saturate(130%);
    backdrop-filter: blur(12px) saturate(130%);
  }

  /* Over a full-screen film, the resting header is light on the image. */
  :global(.overlay-hero) .site-header:not(.is-floating) {
    color: #f6f3ee;
  }

  :global(.overlay-hero) .site-header:not(.is-floating) .primary ul a[aria-current='page'] {
    color: #bfe6e4;
  }

  :global(.overlay-hero) .site-header:not(.is-floating) :global(.logo .on-light) {
    display: none;
  }

  :global(.overlay-hero) .site-header:not(.is-floating) :global(.logo .on-dark) {
    display: block;
  }

  :global(.overlay-hero) .site-header:not(.is-floating) .header-cta {
    background: rgb(246 243 238 / 0.14);
    border-color: rgb(246 243 238 / 0.6);
    color: #f6f3ee;
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  :global(.overlay-hero) .site-header:not(.is-floating) .header-cta:hover {
    background: rgb(246 243 238 / 0.28);
  }

  :global(.overlay-hero) .site-header:not(.is-floating) :focus-visible {
    outline-color: #f6f3ee;
  }

  @media (prefers-reduced-transparency: reduce) {
    .site-header.is-floating .bar {
      background: var(--stone);
      backdrop-filter: none;
    }
  }

  .brand {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }

  .primary {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2.5vw, 2.25rem);
  }

  .primary ul {
    display: flex;
    gap: clamp(1.25rem, 2.5vw, 2.25rem);
    list-style: none;
    padding: 0;
  }

  .primary ul a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.9688rem;
    text-decoration: none;
  }

  .primary ul a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.55rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--dur-2) var(--ease-out);
  }

  .primary ul a:hover::after,
  .primary ul a[aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .primary ul a[aria-current='page'] {
    color: var(--lagoon);
  }

  .header-cta {
    min-height: 2.9rem;
    padding: 0.6rem 1.3rem;
  }

  .menu-toggle,
  .menu-close {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 44px;
    padding: 0 0.75rem;
    border: 0;
    background: none;
    font-size: 0.9688rem;
  }

  .lines {
    position: relative;
    width: 1.5rem;
    height: 0.5rem;
  }

  .lines i {
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: currentColor;
    transition: transform var(--dur-2) var(--ease-out);
  }

  .lines i:first-child {
    top: 0;
  }

  .lines i:last-child {
    bottom: 0;
  }

  .lines.is-x i:first-child {
    transform: translateY(0.25rem) rotate(45deg);
  }

  .lines.is-x i:last-child {
    transform: translateY(-0.25rem) rotate(-45deg);
  }

  .menu-toggle {
    display: none;
  }

  @media (max-width: 860px) {
    .primary {
      display: none;
    }
    .menu-toggle {
      display: inline-flex;
    }
  }

  /* Mobile menu ------------------------------------------------------------ */
  .menu {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: calc(0.75rem + env(safe-area-inset-top, 0px)) var(--gutter) calc(2rem + env(safe-area-inset-bottom, 0px));
    border: 0;
    background: var(--stone);
    color: var(--ink);
  }

  .menu[open] {
    display: flex;
    flex-direction: column;
  }

  .menu::backdrop {
    background: var(--stone);
  }

  .menu-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4rem;
  }

  .menu nav {
    margin-top: auto;
  }

  .menu ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.1rem;
  }

  .menu li a {
    display: block;
    padding-block: 0.25rem;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(2.8rem, 13vw, 4.2rem);
    line-height: 1.1;
    text-decoration: none;
  }

  .menu li a[aria-current='page'] {
    font-style: italic;
    color: var(--lagoon);
  }

  .menu-cta {
    margin-top: 2rem;
    align-self: stretch;
  }

  .menu-facts {
    display: grid;
    gap: 0.25rem;
    margin-top: 1.25rem;
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }

  .menu-facts a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink);
  }

  .menu-facts span {
    display: block;
  }

  @media (prefers-reduced-motion: no-preference) {
    .menu[open] li,
    .menu[open] .menu-cta {
      animation: menu-in var(--dur-3) var(--ease-out) both;
      animation-delay: calc(80ms + var(--i, 4) * 70ms);
    }
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(2.5rem);
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const sentinel = document.querySelector('[data-header-sentinel]');
  if (header && sentinel && 'IntersectionObserver' in window) {
    new IntersectionObserver(
      ([entry]) => {
        header.classList.toggle('is-floating', !entry.isIntersecting);
      },
      { rootMargin: '48px 0px 0px 0px' },
    ).observe(sentinel);
  }

  const menu = document.querySelector<HTMLDialogElement>('[data-menu]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close]');
  openBtn?.addEventListener('click', () => {
    menu?.showModal();
    openBtn.setAttribute('aria-expanded', 'true');
    // The page behind stays still while the menu is open.
    document.documentElement.style.overflow = 'hidden';
  });
  closeBtn?.addEventListener('click', () => menu?.close());
  menu?.addEventListener('close', () => {
    document.documentElement.style.overflow = '';
    openBtn?.setAttribute('aria-expanded', 'false');
    openBtn?.focus();
  });
  matchMedia('(min-width: 861px)').addEventListener('change', (e) => {
    if (e.matches && menu?.open) menu.close();
  });
</script>
