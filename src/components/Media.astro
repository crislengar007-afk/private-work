---
/**
 * Responsive image in a reserved frame. The frame's ratio is known before
 * the image loads, so nothing shifts. `native` caps the rendered width at
 * the photograph's own pixel width, so small originals are never enlarged.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image?: ImageMetadata;
  alt: string;
  /** Frame ratio (width / height). Defaults to the image's own ratio. */
  ratio?: number;
  sizes: string;
  widths?: number[];
  eager?: boolean;
  zoom?: boolean;
  arch?: boolean;
  native?: boolean;
  position?: string;
  pendingLabel?: string;
  class?: string;
}

const {
  image,
  alt,
  ratio,
  sizes,
  widths = [360, 540, 720, 960, 1280, 1680, 2200],
  eager = false,
  zoom = false,
  arch = false,
  native = false,
  position,
  pendingLabel = 'Image pending',
  class: className,
} = Astro.props;

const frameRatio = ratio ?? (image ? image.width / image.height : 4 / 5);
const usable = image ? widths.filter((w) => w <= image.width) : [];
if (image && (usable.length === 0 || usable[usable.length - 1] < image.width)) usable.push(image.width);
const style = [
  `aspect-ratio: ${frameRatio.toFixed(4)}`,
  native && image ? `max-width: ${image.width}px` : '',
  position ? `--pos: ${position}` : '',
]
  .filter(Boolean)
  .join('; ');
---

<div class:list={['frame', { 'frame--zoom': zoom, 'frame--arch': arch }, className]} style={style}>
  {
    image ? (
      <Picture
        src={image}
        alt={alt}
        widths={usable}
        sizes={sizes}
        formats={['avif', 'webp']}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
        decoding={eager ? 'sync' : 'async'}
        style={position ? 'object-position: var(--pos)' : undefined}
      />
    ) : (
      <div class="pending" role="img" aria-label={pendingLabel}>
        <span>{pendingLabel}</span>
      </div>
    )
  }
</div>
