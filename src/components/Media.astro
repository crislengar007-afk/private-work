---
/**
 * Responsive image inside a reserved frame. When the image has not been
 * supplied yet, renders a clearly labelled pending slot of the same shape.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image?: ImageMetadata;
  alt: string;
  /** Frame ratio (width / height). Defaults to the image's own ratio. */
  ratio?: number;
  sizes: string;
  widths?: number[];
  eager?: boolean;
  zoom?: boolean;
  pendingLabel?: string;
  class?: string;
  position?: string;
}

const {
  image,
  alt,
  ratio,
  sizes,
  widths = [480, 720, 960, 1280, 1680, 2200],
  eager = false,
  zoom = false,
  pendingLabel = 'Photograph pending',
  class: className,
  position,
} = Astro.props;

const frameRatio = ratio ?? (image ? image.width / image.height : 4 / 5);
const usable = image ? widths.filter((w) => w <= image.width) : [];
if (image && usable.length === 0) usable.push(image.width);
---

<div
  class:list={['frame', { 'frame--zoom': zoom }, className]}
  style={`aspect-ratio: ${frameRatio.toFixed(4)};${position ? ` --pos: ${position};` : ''}`}
>
  {
    image ? (
      <Picture
        src={image}
        alt={alt}
        widths={usable}
        sizes={sizes}
        formats={['avif', 'webp']}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
        decoding={eager ? 'sync' : 'async'}
        style={position ? 'object-position: var(--pos)' : undefined}
      />
    ) : (
      <div class="pending" role="img" aria-label={pendingLabel}>
        <span>{pendingLabel}</span>
      </div>
    )
  }
</div>
