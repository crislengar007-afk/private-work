---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactDock from '../components/ContactDock.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Root-relative or absolute URL of a social preview image. */
  image?: string;
  /** Show the mobile contact dock (off on the Contact page). */
  dock?: boolean;
  /** Emit LocalBusiness structured data (Home page). */
  business?: boolean;
  /** The page opens with a full-screen film: the header starts light, over it. */
  overlay?: boolean;
}

const { title, description, image, dock = true, business = false, overlay = false } = Astro.props;
const fullTitle = title === site.name ? title : `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url);
const ogImage = image ? new URL(image, Astro.site ?? site.url).href : undefined;
const { contact } = site;

// Only facts displayed on the live site; confirm with the owner before launch.
const jsonLd = business && {
  '@context': 'https://schema.org',
  '@type': 'Florist',
  name: site.name,
  url: site.url,
  email: contact.email,
  telephone: contact.phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Ports of Call, Leeward through Grace Bay',
    addressRegion: 'Providenciales',
    postalCode: 'TKCA 1ZZ',
    addressCountry: 'TC',
  },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'], opens: '07:00', closes: '19:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Sunday', opens: '08:00', closes: '15:00' },
  ],
  sameAs: [contact.instagram && `https://www.instagram.com/${contact.instagram}/`, contact.facebook].filter(Boolean),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#ece7de" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121817" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <slot name="head" />
  </head>
  <body class:list={{ 'overlay-hero': overlay }}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {dock && <ContactDock />}

    <script>
      import { initMotion } from '../scripts/motion';
      initMotion();
    </script>

    <script>
      // Gentle entrance for content marked [data-reveal]; once per element.
      const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-revealed'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-revealed');
              io.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
        );
        targets.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
