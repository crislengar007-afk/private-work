# Copy to .env.local (never commit it). All values are per environment.

# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS. Never expose it to the browser or Part A.
SUPABASE_SERVICE_ROLE_KEY=

# This app's public origin, e.g. https://book.fmvevents.ca (used in emails, PDFs, QR codes)
APP_URL=http://localhost:3000
# Part A (marketing site) origin, allowed by CORS on /api/public/availability
PUBLIC_SITE_ORIGIN=

# Email (Resend). Without these, emails are logged as "skipped" in email_log.
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. "FMV Events & Photography <bookings@fmvevents.ca>"
EMAIL_FROM=
# Fallback owner alert address if settings.email is empty
OWNER_ALERT_EMAIL=

# Cloudflare Turnstile (anonymous forms). Without the secret, forms are only rate limited.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron
CRON_SECRET=
