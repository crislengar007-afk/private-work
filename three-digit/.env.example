# Local DEMO configuration. Copy to .env. Contains no secrets; there are no real
# payment, email or lottery integrations in this project.

# HTTP listener (loopback only by default; do not expose the demo publicly).
HOST=127.0.0.1
PORT=3000

# SQLite database file. Reset/seed scripts refuse any path outside ./data/.
DATABASE_PATH=data/demo.sqlite

# development | test | production. In production the cookies are Secure and the
# demo clock, demo-account list and reset script are disabled.
NODE_ENV=development

# Local-only convenience: list the seeded synthetic demo accounts on /login.
SHOW_DEMO_ACCOUNTS=true

# Local-only: allow an administrator to move the server's demo clock FORWARD
# (never backward) so cutoffs and draw times can be demonstrated quickly.
DEMO_CLOCK_CONTROLS=true

# Max login/register/reset attempts per IP per 10 minutes.
AUTH_RATE_LIMIT=20
